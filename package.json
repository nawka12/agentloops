{
  "name": "@nawka12/agentloops",
  "version": "1.0.0",
  "description": "FL Studio, but for AI agents: build multi-agent pipelines as songs, driven from Claude Code or any MCP harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nawka12/agentloops.git"
  },
  "type": "module",
  "bin": {
    "agentloops": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "ui",
    "presets",
    "examples/*.alp.json",
    "docs/manual.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "build": "node --disable-warning=ExperimentalWarning scripts/build.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@marcbachmann/cel-js": "^8.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "htm": "^3.1.1",
    "preact": "^10.29.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
